<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.silkway.singbox</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Applications/Silkway.app/Contents/Resources/sing-box</string>
		<string>run</string>
		<string>-c</string>
		<string>/Users/Shared/Silkway/tun-config.json</string>
		<string>-D</string>
		<string>/Users/Shared/Silkway</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/Users/Shared/Silkway/tun-daemon.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/Shared/Silkway/tun-daemon.log</string>
</dict>
</plist>
